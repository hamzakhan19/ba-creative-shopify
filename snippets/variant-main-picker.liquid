}

{% endstylesheet %}
<script>
  document.addEventListener('click', (e) => {
    const open = e.target.closest('[data-size-guide-open]');
    if (open) {
      const modal = open.parentElement.querySelector('[data-size-guide-modal]');
      if (modal) modal.hidden = false;
      return;
    }

    const close = e.target.closest('[data-size-guide-close]');
    if (close) {
      const modal = close.closest('[data-size-guide-modal]');
      if (modal) modal.hidden = true;
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('[data-size-guide-modal]:not([hidden])').forEach(m => m.hidden = true);
  });
</script>
