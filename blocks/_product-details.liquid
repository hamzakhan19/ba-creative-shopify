{%- assign block_settings = block.settings -%}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="--details-position: {{ block_settings.details_position }};"
  data-testid="product-information-details"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    <div class="view-product-title">
      <a
        href="{{ closest.product.selected_or_first_available_variant.url }}"
        class="link"
      >
        {{- closest.product.title }}
      </a>
    </div>

    {% content_for 'blocks' %}

    {%- comment -%}
      ✅ AFTER Buy Buttons Metafields
      1) custom.introduction
      2) custom.usp_icons
      3) Accordion metafields (like screenshot):
         - custom.product_details
         - custom.size_fit
         - custom.shipping_and_returns
    {%- endcomment -%}

    {%- assign mf_intro = closest.product.metafields.custom.introduction -%}
    {%- assign mf_usp   = closest.product.metafields.custom.usp_icons -%}

    {%- assign mf_pd    = closest.product.metafields.custom.product_details -%}
    {%- assign mf_sf    = closest.product.metafields.custom.size_fit -%}
    {%- assign mf_sr    = closest.product.metafields.custom.shipping_and_returns -%}

    {% if mf_intro != blank or mf_usp != blank or mf_pd != blank or mf_sf != blank or mf_sr != blank %}
      <div class="tmg-after-buy-metafields">

        {%- if mf_intro != blank -%}
          <div class="tmg-after-buy-introduction">
            {%- if mf_intro.type contains 'rich_text' -%}
              {{ mf_intro | metafield_tag }}
            {%- else -%}
              {{ mf_intro.value | default: mf_intro }}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if mf_usp != blank and mf_usp.value != blank and mf_usp.value.size > 0 -%}
  <div class="tmg-after-buy-usp">
    <div class="tmg-usp-grid">
      {%- for ref in mf_usp.value -%}

        {%- assign mo = ref.value | default: ref -%}
        {%- assign usp_icon_url = blank -%}
        {%- assign usp_text = blank -%}

        {%- comment -%}
          Metaobject fields from your screenshot:
          - image (File)
          - text (Multi-line text)
        {%- endcomment -%}

        {%- assign img_field = blank -%}
        {%- if mo.fields != blank and mo.fields.image != blank -%}
          {%- assign img_field = mo.fields.image.value | default: mo.fields.image -%}
        {%- elsif mo.image != blank -%}
          {%- assign img_field = mo.image.value | default: mo.image -%}
        {%- endif -%}

        {%- if img_field != blank -%}
          {%- if img_field.preview_image -%}
            {%- assign usp_icon_url = img_field.preview_image | image_url: width: 120 -%}
          {%- else -%}
            {%- assign usp_icon_url = img_field | image_url: width: 120 -%}
          {%- endif -%}
        {%- endif -%}

        {%- if mo.fields != blank and mo.fields.text != blank -%}
          {%- assign usp_text = mo.fields.text.value | default: mo.fields.text -%}
        {%- elsif mo.text != blank -%}
          {%- assign usp_text = mo.text.value | default: mo.text -%}
        {%- endif -%}

        <div class="tmg-usp-item">
          {% if usp_icon_url != blank %}
            <div class="tmg-usp-icon">
              <img
                src="{{ usp_icon_url }}"
                alt="{{ usp_text | default: closest.product.title | escape }}"
                loading="lazy"
                width="28"
                height="28"
              >
            </div>
          {% endif %}

       
          {% if usp_text != blank %}
            <div class="tmg-usp-text">{{ usp_text }}</div>
          {% endif %}
        
        </div>

      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

        {%- comment -%}
          ✅ Accordion section like screenshot
        {%- endcomment -%}
        {% if mf_pd != blank or mf_sf != blank or mf_sr != blank %}
          <div class="tmg-mf-accordion">

            {% if mf_pd != blank %}
              <details class="tmg-acc-item" open>
                <summary class="tmg-acc-summary">
                  <span class="tmg-acc-title">PRODUCT DETAILS</span>
                  <span class="tmg-acc-icon" aria-hidden="true"></span>
                </summary>
                <div class="tmg-acc-content">
                  {%- if mf_pd.type contains 'rich_text' -%}
                    {{ mf_pd | metafield_tag }}
                  {%- else -%}
                    {{ mf_pd.value | default: mf_pd }}
                  {%- endif -%}
                </div>
              </details>
            {% endif %}

         {% if mf_sf != blank and mf_sf.value != blank %}
  <details class="tmg-acc-item">
    <summary class="tmg-acc-summary">
      <span class="tmg-acc-title">SIZE &amp; FIT</span>
      <span class="tmg-acc-icon" aria-hidden="true"></span>
    </summary>

    <div class="tmg-acc-content">
      {{ mf_sf.value | escape | newline_to_br }}
    </div>
  </details>
{% endif %}

            {% if mf_sr != blank %}
              <details class="tmg-acc-item">
                <summary class="tmg-acc-summary">
                  <span class="tmg-acc-title">SHIPPING &amp; RETURNS</span>
                  <span class="tmg-acc-icon" aria-hidden="true"></span>
                </summary>
                <div class="tmg-acc-content">
                  {%- if mf_sr.type contains 'rich_text' -%}
                    {{ mf_sr | metafield_tag }}
                  {%- else -%}
                    {{ mf_sr.value | default: mf_sr }}
                  {%- endif -%}
                </div>
              </details>
            {% endif %}

          </div>
        {% endif %}

      </div>
    {% endif %}

  {% endcapture %}

  {% render 'group', children: children, settings: block_settings, shopify_attributes: block.shopify_attributes %}
</div>

{% stylesheet %}
  /* Clear padding on mobile, if not full-width */
  @media screen and (max-width: 749px) {
    .product-information.section--page-width .product-details > .group-block {
      padding-inline: 0;
    }
  }

  .view-product-title {
    display: none;
  }

  /* Container styles */
  .product-details {
    display: flex;
    align-self: start;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .product-details > .group-block {
      height: min-content;
    }

    .full-height--desktop {
      height: 100%;
      max-height: calc(100vh - var(--header-group-height, 0));
      min-height: fit-content;
    }

    .full-height--desktop .group-block {
      align-self: var(--details-position, 'flex-start');
    }
  }

  /* ✅ After Buy Now Metafields UI */
  .tmg-after-buy-metafields {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tmg-after-buy-introduction {
    font-size: 14px;
    line-height: 1.5;
    color: #3b3b3b;
  }

  .tmg-after-buy-usp .tmg-usp-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media screen and (min-width: 990px) {
    .tmg-after-buy-usp .tmg-usp-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tmg-usp-item {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 10px;
    padding: 10px 12px;
  }

  .tmg-usp-icon img {
    display: block;
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .tmg-usp-text {
    font-size: 13px;
    line-height: 1.3;
    color: #1b1b1b;
    font-weight: 500;
  }

  .tmg-usp-text-only {
    font-size: 13px;
    color: #1b1b1b;
  }

  /* ✅ Accordion (matches screenshot style) */
  .tmg-mf-accordion {
    border-top: 1px solid rgba(0,0,0,0.12);
  }

  .tmg-acc-item {
    border-bottom: 1px solid rgba(0,0,0,0.12);
    padding: 0;
  }

  .tmg-acc-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 0;
  }

  .tmg-acc-summary::-webkit-details-marker {
    display: none;
  }

  .tmg-acc-title {
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1b1b1b;
    font-weight: 500;
  }

  .tmg-acc-icon {
    position: relative;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
  }

  /* Plus */
  .tmg-acc-icon::before,
  .tmg-acc-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1.5px;
    background: rgba(0,0,0,0.8);
    transform: translate(-50%, -50%);
  }

  .tmg-acc-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* Minus when open */
  details[open] .tmg-acc-icon::after {
    display: none;
  }

  .tmg-acc-content {
    padding: 0 0 16px 0;
    color: #3b3b3b;
    font-size: 14px;
    line-height: 1.6;
  }

  /* Nice list spacing inside content */
  .tmg-acc-content ul {
    margin: 10px 0 0 18px;
  }
  .tmg-acc-content li {
    margin: 6px 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.details",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "text" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "button" },
    { "type": "video" },
    { "type": "group" },
    { "type": "spacer" },
    { "type": "accordion" },
    { "type": "product-recommendations" },
    { "type": "price" },
    { "type": "variant-picker" },
    { "type": "buy-buttons" },
    { "type": "product-description" },
    { "type": "review" },
    { "type": "accelerated-checkout" },
    { "type": "_divider" },
    { "type": "product-inventory" },
    { "type": "product-custom-property" }
  ],
  "tag": null,
  "settings": [
    { "type": "header", "content": "t:content.size" },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "fill", "label": "t:options.fill" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "fill", "label": "t:options.fill" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        { "value": "fit", "label": "t:options.fit_content" },
        { "value": "fill", "label": "t:options.fill" }
      ],
      "default": "fit"
    },
    { "type": "header", "content": "t:content.layout" },
    {
      "type": "select",
      "id": "details_position",
      "label": "t:settings.position",
      "options": [
        { "value": "flex-start", "label": "t:options.top" },
        { "value": "center", "label": "t:options.center" },
        { "value": "flex-end", "label": "t:options.bottom" }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.height == \"fill\" }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "sticky_details_desktop",
      "label": "t:settings.make_details_sticky_desktop",
      "default": false
    },
    { "type": "header", "content": "t:content.appearance" },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.details"
    }
  ]
}
{% endschema %}
<style>
  .tmg-after-buy-usp .tmg-usp-grid{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:40px;
}

.tmg-usp-item{
  display:flex;
  align-items:center;
  justify-content:center;
  border:0;
  padding:0;
}

.tmg-usp-icon img{
  width:28px;
  height:28px;
  object-fit:contain;
  display:block;
}
/* Container row */
.tmg-after-buy-usp .tmg-usp-grid{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:40px;
}

/* Each USP block */
.tmg-usp-item{
  display:flex;
  flex-direction:column;   /* STACK icon + text */
  align-items:center;      /* CENTER horizontally */
  justify-content:center;
  text-align:center;
  gap:12px;
  border:0;
  padding:0;
  flex:1;                  /* equal width for 3 items */
}

/* Icon */
.tmg-usp-icon img{
  width:28px;
  height:28px;
  object-fit:contain;
  display:block;
}

/* Text */
.tmg-usp-text{
  font-size:13px;
  line-height:1.4;
  letter-spacing:0.06em;
  text-transform:uppercase;
}
</style>